---
import { elsewhere } from '../data/site';
const year = new Date().getFullYear();
---

<footer id="contact" class="site-footer">
  <div class="wrap inner">
    <div class="invite">
      <h2>Get in touch</h2>
      <p class="sub">
        I'm always happy to talk about building companies, leading engineering teams, or an
        idea you're trying to get off the ground.
      </p>
    </div>

    <nav class="links" aria-label="Elsewhere">
      {elsewhere.map((item) => (
        <a href={item.href} rel={item.href.startsWith('http') ? 'me noopener' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  <div class="wrap colophon">
    <span>&copy; {year} Hasitha Pathiraja</span>
    <span>Toronto</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: var(--section-y);
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  .inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding-bottom: 3.5rem;
  }
  .invite h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.03em;
  }
  .invite .sub {
    margin-top: 1rem;
    max-width: 46ch;
    color: var(--muted);
    font-size: 1.08rem;
  }
  .links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem 1.5rem;
    font-size: 1.05rem;
    padding-top: 0.4rem;
  }
  .links a {
    color: var(--text);
    text-decoration: none;
    width: fit-content;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }
  .links a:hover { color: var(--accent); border-color: var(--accent); }

  .colophon {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.75rem 0 2.5rem;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .inner { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
