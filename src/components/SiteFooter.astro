---
import { elsewhere } from '../data/site';
const year = new Date().getFullYear();

const icons: Record<string, string> = {
  github:
    '<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>',
  linkedin:
    '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
  email:
    '<rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 7 9 6 9-6"/>',
};
const strokeIcon = (key: string) => key === 'email';
---

<footer id="contact" class="site-footer">
  <div class="wrap inner">
    <div class="invite">
      <h2>Get in touch</h2>
      <p class="sub">
        I'm always happy to talk about building companies, leading engineering teams, or an
        idea you're trying to get off the ground.
      </p>
    </div>

    <nav class="links" aria-label="Elsewhere">
      {elsewhere.map((item) => (
        <a
          class="social"
          href={item.href}
          aria-label={item.label}
          title={item.label}
          rel={item.href.startsWith('http') ? 'me noopener' : undefined}
        >
          <svg
            viewBox="0 0 24 24"
            fill={strokeIcon(item.key) ? 'none' : 'currentColor'}
            stroke={strokeIcon(item.key) ? 'currentColor' : 'none'}
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={icons[item.key]}
          />
        </a>
      ))}
    </nav>
  </div>

  <div class="wrap colophon">
    <span>&copy; {year} Hasitha Pathiraja</span>
    <span>Made in Toronto</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: var(--section-y);
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  .inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding-bottom: 3.5rem;
  }
  .invite h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.03em;
  }
  .invite .sub {
    margin-top: 1rem;
    max-width: 46ch;
    color: var(--muted);
    font-size: 1.08rem;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 0.6rem;
  }
  .social {
    color: var(--muted);
    display: inline-flex;
    transition: color 0.2s var(--ease-out);
  }
  .social:hover { color: var(--accent); }
  .social svg { width: 22px; height: 22px; display: block; }

  .colophon {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.75rem 0 2.5rem;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .inner { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
