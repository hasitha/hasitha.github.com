---
import { nav } from '../data/site';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="#top">Hasitha Pathiraja</a>
    <div class="bar-right">
      <nav class="nav" aria-label="Primary">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <span class="nav-indicator" aria-hidden="true"></span>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector('.theme-toggle');
  if (btn) {
    const root = document.documentElement;
    const resolve = () =>
      root.getAttribute('data-theme') ||
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const syncLabel = () => {
      const label = resolve() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
    };
    syncLabel();
    btn.addEventListener('click', () => {
      const next = resolve() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
      syncLabel();
    });
  }
</script>

<script>
  // Scroll-spy: mark the nav item for the section currently in view.
  const navLinks = Array.from(document.querySelectorAll('.site-header .nav a[href^="#"]'));
  const sections = navLinks
    .map((link) => {
      const el = document.getElementById(link.getAttribute('href').slice(1));
      return el ? { id: el.id, el, link } : null;
    })
    .filter(Boolean);

  if (sections.length) {
    const indicator = document.querySelector('.site-header .nav-indicator');
    let currentId;

    const linkFor = (id) => {
      const s = sections.find((x) => x.id === id);
      return s ? s.link : null;
    };

    // Slide the shared underline under the active link (or hide it when none).
    const moveIndicator = (link) => {
      if (!indicator) return;
      if (link) {
        indicator.style.width = link.offsetWidth + 'px';
        indicator.style.transform = 'translateX(' + link.offsetLeft + 'px)';
        indicator.style.opacity = '1';
      } else {
        indicator.style.opacity = '0';
      }
    };

    const setCurrent = (id) => {
      if (id === currentId) return;
      currentId = id;
      for (const s of sections) {
        if (s.id === id) s.link.setAttribute('aria-current', 'true');
        else s.link.removeAttribute('aria-current');
      }
      moveIndicator(linkFor(id));
    };

    const update = () => {
      const line = 90; // activation line, just below the sticky header
      let active = null;
      for (const s of sections) {
        if (s.el.getBoundingClientRect().top <= line) active = s.id;
      }
      // At the very bottom, make sure the last section (Contact) wins.
      const atBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      if (atBottom) active = sections[sections.length - 1].id;
      setCurrent(active);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };

    // Set the first position without animating in from the far left.
    if (indicator) indicator.style.transition = 'none';
    update();
    if (indicator) {
      requestAnimationFrame(() => {
        indicator.style.transition = '';
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener(
      'resize',
      () => {
        onScroll();
        moveIndicator(linkFor(currentId)); // link offsets change on resize
      },
      { passive: true }
    );

    // Re-measure once the web font settles, since text widths shift.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => moveIndicator(linkFor(currentId)));
    }
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.1) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 66px;
  }
  .bar-right {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
  }
  .wordmark {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav {
    position: relative;
    display: flex;
    gap: clamp(1.1rem, 3vw, 2.2rem);
    font-size: 0.95rem;
  }
  .nav a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.25s var(--ease-out);
  }
  .nav a:hover { color: var(--text); }
  .nav a[aria-current] { color: var(--text); }
  /* A single underline that slides between items as the active section changes. */
  .nav-indicator {
    position: absolute;
    bottom: -0.45em;
    left: 0;
    width: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    opacity: 0;
    transform: translateX(0);
    transition:
      transform 0.34s var(--ease-out),
      width 0.34s var(--ease-out),
      opacity 0.2s var(--ease-out);
    pointer-events: none;
  }

  @media (max-width: 460px) {
    .wordmark { font-size: 0; }
    .wordmark::after { content: 'HP'; font-size: 0.95rem; letter-spacing: 0.02em; }
    .nav { gap: 1rem; font-size: 0.9rem; }
  }
</style>
