---
import { nav } from '../data/site';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="#top">Hasitha Pathiraja</a>
    <nav class="nav" aria-label="Primary">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.1) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 66px;
  }
  .wordmark {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav {
    display: flex;
    gap: clamp(1.1rem, 3vw, 2.2rem);
    font-size: 0.95rem;
  }
  .nav a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }
  .nav a:hover { color: var(--text); }

  @media (max-width: 460px) {
    .wordmark { font-size: 0; }
    .wordmark::after { content: 'HP'; font-size: 0.95rem; letter-spacing: 0.02em; }
    .nav { gap: 1rem; font-size: 0.9rem; }
  }
</style>
